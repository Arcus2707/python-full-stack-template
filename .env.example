# Application
APP_ENV=development
APP_DEBUG=true
APP_NAME="Python Full-Stack Template"
APP_SECRET_KEY=change-me-in-production
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO

# Database (async SQLAlchemy URL)
APP_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/app

# Cache / Redis
APP_REDIS_URL=redis://localhost:6379/0
APP_CACHE_TTL=300

# Celery
APP_CELERY_BROKER_URL=redis://localhost:6379/1
APP_CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Auth domain (src/auth/config.py)
APP_AUTH_SECRET_KEY=change-me-in-production
APP_AUTH_ALGORITHM=HS256
APP_AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=60

# AWS domain example (src/aws/config.py)
APP_AWS_REGION=us-east-1
APP_AWS_ACCESS_KEY_ID=
APP_AWS_SECRET_ACCESS_KEY=
APP_AWS_BUCKET=example-bucket
